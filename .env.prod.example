# Production environment — copy to .env on your GCP VM and fill in every value.
# NEVER commit this file with real secrets.
#
# Usage:
#   scp .env.prod.example user@VM_IP:~/automation-tools/.env
#   (then edit it on the VM)

# ── App ──
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-string   # openssl rand -hex 32
# Allow the VM's public IP/domain. nginx serves the frontend + proxies /api,
# so the browser and backend are on the same origin. Add your domain if you
# set up DNS later.
CORS_ORIGINS=["https://tools.scalebrandslab.com"]
API_V1_STR=/api/v1

# ── Postgres ──
# POSTGRES_HOST / PORT are overridden in docker-compose.prod.yml to use the
# internal Docker service name (postgres:5432). These values are only needed
# if you run alembic outside Docker.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=myapp

# ── MongoDB ──
# URI is overridden in docker-compose.prod.yml to mongodb://mongo:27017
MONGO_LOCAL_URI=mongodb://mongo:27017
MONGO_DB_NAME=myapp_docs
MONGO_TEST_DB_NAME=myapp_docs_test

# ── Redis ──
# HOST / PORT are overridden in docker-compose.prod.yml (redis:6379)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-password   # required in prod

# ── Celery / Flower ──
FLOWER_URL=http://flower:5555
# Protect Flower UI with HTTP basic auth (user:password)
FLOWER_BASIC_AUTH=admin:replace-with-strong-password

# ── YouTube ──
YOUTUBE_API_KEY_V3=your-youtube-data-api-v3-key
# Optional; used in order when the previous key's quota is exhausted in the same run
YOUTUBE_API_KEY_V3_2=
YOUTUBE_API_KEY_V3_3=
YOUTUBE_API_KEY_V3_4=
YOUTUBE_DAILY_CREDIT_LIMIT=10000

# ── GCP (optional — used by Secret Manager integration) ──
# GCP_PROJECT_ID=
# GCP_SECRET_NAME=

# ── Google Sheets ──
# The service-account JSON must exist at repo root as credentials.json
# (docker-compose.prod.yml mounts it into the containers at /app/credentials.json)
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── AWS (thumbnail pipeline: S3 upload from backend + Celery worker) ──
# Use an IAM user or role whose policy allows s3:PutObject (and GetObject if you
# read objects) on thumbnail-inputs/* and thumbnails/* in THUMBNAIL_S3_BUCKET.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only if using temporary credentials
AWS_REGION=ap-south-1
THUMBNAIL_S3_BUCKET=thumbnail-generator-ai-agent
# THUMBNAIL_S3_ENDPOINT_URL=
# THUMBNAIL_S3_PUBLIC_BASE_URL=
# THUMBNAIL_S3_USE_PRESIGNED_URL=false
# THUMBNAIL_S3_PRESIGNED_EXPIRES_SECONDS=3600

# ── AI (thumbnail generation) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
# Flux Kontext (the "fluxkontext" thumbnail model, default in the UI) — https://api.bfl.ai
BFL_API_KEY=
