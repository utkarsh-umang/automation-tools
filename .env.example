# Monorepo env — copy to .env and fill in values
# Run: cp .env.example .env
#
# Backend (FastAPI) reads these when started via Task or uvicorn

# ── App ──
ENVIRONMENT=local
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]
API_V1_STR=/api/v1

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# ── MongoDB ──
MONGO_LOCAL_URI=mongodb://localhost:27017
MONGO_DB_NAME=myapp_docs
MONGO_TEST_DB_NAME=myapp_docs_test

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── GCP (optional, prod only) ──
# GCP_PROJECT_ID=
# GCP_SECRET_NAME=
