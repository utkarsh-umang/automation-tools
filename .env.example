# Monorepo env — copy to .env and fill in values
# Run: cp .env.example .env
#
# Backend (FastAPI) reads these when started via Task or uvicorn

# ── App ──
ENVIRONMENT=local
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
API_V1_STR=/api/v1

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=54332
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# ── MongoDB ──
MONGO_LOCAL_URI=mongodb://localhost:27017
MONGO_DB_NAME=myapp_docs
MONGO_TEST_DB_NAME=myapp_docs_test

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6383
# REDIS_PASSWORD=

# ── Celery / Flower (Flower runs in Docker; health check uses this URL) ──
FLOWER_URL=http://localhost:5555

# ── GCP (optional, prod only) ──
# GCP_PROJECT_ID=
# GCP_SECRET_NAME=

# ── AWS (thumbnail pipeline: S3 upload from backend + Celery worker) ──
# Use an IAM user or role whose policy allows s3:PutObject (and GetObject if you
# read objects) on thumbnail-inputs/* and thumbnails/* in THUMBNAIL_S3_BUCKET.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only if using temporary credentials
AWS_REGION=ap-south-1
THUMBNAIL_S3_BUCKET=thumbnail-generator-ai-agent
# THUMBNAIL_S3_ENDPOINT_URL=
# THUMBNAIL_S3_PUBLIC_BASE_URL=
# THUMBNAIL_S3_USE_PRESIGNED_URL=false
# THUMBNAIL_S3_PRESIGNED_EXPIRES_SECONDS=3600

# ── AI (thumbnail generation) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
# Flux Kontext (the "fluxkontext" thumbnail model, default in the UI) — https://api.bfl.ai
BFL_API_KEY=
