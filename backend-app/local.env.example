# ── App ──
ENVIRONMENT=local
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]
API_V1_STR=/api/v1

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=54332
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# ── MongoDB ──
MONGO_LOCAL_URI=mongodb://localhost:27017
MONGO_DB_NAME=myapp_docs
MONGO_TEST_DB_NAME=myapp_docs_test

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6383
# REDIS_PASSWORD=

# ── Flower (Docker Compose publishes 5555) ──
FLOWER_URL=http://localhost:5555

# ── Thumbnail / S3 (Celery ``thumbnail.generate_thumbnail``) ──
# THUMBNAIL_S3_BUCKET=
# AWS_REGION=us-east-1
# THUMBNAIL_S3_ENDPOINT_URL=   # e.g. MinIO http://localhost:9000
# THUMBNAIL_S3_PUBLIC_BASE_URL=   # optional CDN base (public buckets)
# THUMBNAIL_S3_USE_PRESIGNED_URL=false
# THUMBNAIL_S3_PRESIGNED_EXPIRES_SECONDS=3600
# Key format is fixed: thumbnails/{job_id}.png (see app.constants.s3_keys)

# ── YouTube ──
YOUTUBE_API_KEY_V3=
# Optional extra keys (used in order after the previous key's daily quota is exhausted in the same run)
YOUTUBE_API_KEY_V3_2=
YOUTUBE_API_KEY_V3_3=
YOUTUBE_API_KEY_V3_4=

# ── GCP (optional, prod only) ──
# GCP_PROJECT_ID=
# GCP_SECRET_NAME=
